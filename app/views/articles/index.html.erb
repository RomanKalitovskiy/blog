<h1 class="text-2xl font-bold mb-4">Articles</h1>

<div class="space-y-4">
  <% @articles.each do |article| %>
    <div class="border rounded p-4 shadow-sm">
      <p class="font-semibold text-lg"><%= article.title %></p>
      <p class="text-gray-600 mb-2"><%= article.description %></p>
      <div class="space-x-2">
        <%= link_to "View", article_path(article), class: "text-blue-600 hover:underline" %>
        <%= link_to "Edit", edit_article_path(article), class: "text-yellow-600 hover:underline" %>
        <%= link_to "Delete", article_path(article), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-6">
  <%= link_to "Create new article", new_article_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
</div>
